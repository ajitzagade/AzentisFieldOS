# Copy to .env for local development. Real per-tenant values are deployment
# env vars set by infra/provisioning (AD-2) — never committed, never put in
# infra/tenants/*.json.

DATABASE_URL="postgresql://user:password@localhost:5432/azentisfieldos?schema=public"

# apps/web talks to apps/api only over HTTP (AD-3) — never a direct DB import.
API_URL="http://localhost:3001"
# Same API, exposed to the browser bundle for client-side fetches (the
# mobile DSR flow calls apps/api directly from client JS, not a Server
# Action, since story 3.2's offline queue needs to run in the browser).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Clerk (AD-10) — this tenant's Clerk instance keys, set by infra/provisioning.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Svix signing secret for the Clerk user-lifecycle webhook (Story 14.2). Used
# by apps/api's POST /webhooks/clerk to verify each payload's authenticity —
# an unverifiable request is rejected, never processed.
CLERK_WEBHOOK_SECRET=""

# Cloudflare R2 (AD-3) — server-only, apps/api alone holds these; apps/web
# never sees them. apps/api uses them only to grant short-lived presigned
# upload/download URLs, never to proxy photo bytes itself (NFR-5).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Copy to .env for local development. Real per-tenant values are deployment
# env vars set by infra/provisioning (AD-2) — never committed, never put in
# infra/tenants/*.json.

DATABASE_URL="postgresql://user:password@localhost:5432/azentisfieldos?schema=public"
# Optional — caps each apps/api Function instance's own pg.Pool size
# (apps/api/src/prisma/prisma.service.ts). Defaults to 5 if unset; only
# raise this if the deployment's actual Postgres connection ceiling is
# known to comfortably support (this value × concurrent Function
# instances) — the default exists specifically to keep that product small
# and predictable under Vercel's per-instance-pool model.
DATABASE_POOL_MAX=""

# apps/web talks to apps/api only over HTTP (AD-3) — never a direct DB import.
API_URL="http://localhost:3001"
# Same API, exposed to the browser bundle for client-side fetches (the
# mobile DSR flow calls apps/api directly from client JS, not a Server
# Action, since story 3.2's offline queue needs to run in the browser).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Custom auth — apps/api owns credentials directly (bcrypt-hashed passwords
# in the User table) and signs its own session JWTs. JWT_SECRET must be a
# unique, strong random value per tenant deployment (never reused across
# tenants, never committed).
JWT_SECRET=""
# Read once by infra/prisma/seed.ts to create the first OWNER_ADMIN when the
# User table is empty — this replaces the old "first Clerk login becomes
# admin" auto-provisioning. Not read anywhere at runtime after seeding.
SEED_ADMIN_NAME=""
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Cloudinary (AD-3) — image storage. Server-only: apps/api alone holds these;
# apps/web never sees the secret. apps/api uses them ONLY to mint a short-lived
# per-upload signature — the browser POSTs the bytes directly to Cloudinary and
# apps/api never proxies photo bytes itself (NFR-5). Delivery URLs are public
# CDN URLs (res.cloudinary.com/<cloud>/image/upload/<public_id>), no presign.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# CLOUDINARY_URL ("cloudinary://<api_key>:<api_secret>@<cloud_name>") also works
# and the SDK auto-reads it — set either this OR the three vars above.
CLOUDINARY_URL=""

# Resend (architecture spine's decided email vendor) — apps/api sends the
# auto-compiled daily report + scheduled reports via Resend (Stories 13.1/14.5).
RESEND_API_KEY=""
# The From address the report emails are sent as (must be a Resend-verified sender).
REPORT_EMAIL_FROM=""

# Vercel Cron shared secret (AD-13). apps/api's @Public cron routes
# (compile-daily-reports, retry-report-deliveries, run-report-schedules) accept
# ONLY requests carrying `Authorization: Bearer $CRON_SECRET`; without it every
# cron invocation 401s. Set the same value here and in the Vercel Cron config.
CRON_SECRET=""

# CORS allowlist for apps/api (comma-separated origins). apps/web calls apps/api
# from client-side JS (DSR pickers, offline queue), so the browser origin(s)
# must be listed. Unset = permissive (`true`) — fine for local dev, set
# explicitly in production.
CORS_ORIGIN=""

# The deployment's local timezone for "today" day-boundary math (Dashboard's
# same-day aggregates, Story 12.1). Defaults to Asia/Kolkata (launch market).
APP_TIMEZONE="Asia/Kolkata"

{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/infra/prisma/**"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "api/index.js"],
      "env": ["VERCEL_ENV", "DATABASE_URL", "ANDROID_PACKAGE_ID", "ANDROID_SHA256_FINGERPRINT", "API_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_VAPID_PUBLIC_KEY"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}

// Single schema, run identically against every tenant's separate database
// (architecture spine AD-2, AD-12). No tenant_id anywhere — AD-1 forbids it;
// a deployment's database belongs to exactly one Tenant.
//
// Tables listed under "Append-only (AD-9)" below are never UPDATEd or
// DELETEd by application code — enforced by revoking those grants from the
// API's Postgres role in the deployment migration, not by Prisma itself.
// A correction is a new row with `correctsId` pointing at the row it fixes
// and a required `reason`.

generator client {
  provider     = "prisma-client"
  output       = "../../apps/api/src/generated/prisma"
  moduleFormat = "cjs" // apps/api is a CommonJS NestJS build, not ESM
}

// Connection URL lives in prisma.config.ts (Prisma 7), not here.
datasource db {
  provider = "postgresql"
}

// ---------- Identity ----------

enum Role {
  OWNER_ADMIN
  SITE_SUPERVISOR
}

// This table owns both authentication (bcrypt passwordHash, verified by
// apps/api's own /auth/login) and authorization (AD-10, AD-11 — Role here is
// the only in-app role set, never "Platform Operator").
model User {
  id           String   @id @default(uuid(7))
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailySiteReports DailySiteReport[]
  photos           Photo[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]
}

// Backs the long-lived side of auth: the access JWT (session cookie) is
// short-lived (1h) so a stolen bearer token has a small blast radius; this
// table lets a user stay signed in for up to 30 days via silent refresh
// without keeping a long-lived token in browser-readable storage. Only a
// SHA-256 hash of the raw token is stored (never the raw value) — a DB dump
// alone can't be replayed as a session. Rotated on every use (the row used
// to refresh is revoked and a new one issued) so a stolen-but-already-used
// refresh token is detectable and dead on arrival for whoever replays it
// second. This is session/auth state, not a transaction-history table —
// AD-9's append-only rule does not apply; `revokedAt` is a plain update.
model RefreshToken {
  id        String    @id @default(uuid(7))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Audit trail (write-once, never updated or deleted): one row per
// successful mutating API request, written automatically by the global
// AuditLogInterceptor — a new write endpoint is audited by construction,
// with no per-service code. Who (userId), what (action/entityType/
// entityId), where (siteId when the write named one), when (occurredAt).
model AuditLog {
  id         String   @id @default(uuid(7))
  occurredAt DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  method     String // POST | PATCH | DELETE
  path       String // the request path, e.g. /waste-disposals
  action     String // human summary, e.g. "Created Waste Disposal"
  entityType String?
  entityId   String?
  siteId     String?

  // The read path is "latest 200, optionally filtered by site/user/date"
  // over a table that grows forever — index the sort key and both filters.
  // The single-column indexes below only serve an unfiltered "recent
  // history" scan; a siteId= or userId= filter combined with the
  // occurredAt-desc order needs its own compound to avoid a scan+filesort.
  @@index([occurredAt])
  @@index([siteId])
  @@index([userId])
  @@index([siteId, occurredAt])
  @@index([userId, occurredAt])
}

// ---------- Sites ----------

enum SiteStatus {
  ACTIVE
  COMPLETED
  ON_HOLD
}

model Site {
  id                String     @id @default(uuid(7))
  name              String
  location          String
  status            SiteStatus @default(ACTIVE)
  contractReference String?
  description       String?
  // Soft delete: a deleted Site disappears from every list/picker but its
  // row — and every transaction row pointing at it — stays in the database
  // (the ledger's history is never destroyed). Master-data-only concept;
  // AD-9 transaction tables are corrected, never deleted.
  deletedAt         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  siteStock          SiteStock[]
  purchases          Purchase[]
  movementsFrom       Movement[]        @relation("MovementSourceSite")
  movementsTo         Movement[]        @relation("MovementDestinationSite")
  consumptions        Consumption[]
  returnWastages       ReturnWastage[]
  machineryMovements   MachineryMovementLog[]
  vehicleMovements     VehicleMovementLog[]
  workRecords          WorkRecord[]
  rmcEntries           RmcEntry[]
  dailySiteReports     DailySiteReport[]
  expenses             Expense[]
  machineryCurrentlyHere Machinery[]
  vehiclesCurrentlyHere  Vehicle[]
  dailyReports         DailyReport[]
  wasteDisposals       WasteDisposal[]
  siteContracts        SiteContract[]
}

// ---------- Material catalog (FR-4..FR-7) ----------

model MaterialCategory {
  id        String     @id @default(uuid(7))
  name      String     @unique
  isActive  Boolean    @default(true)
  materials Material[]
}

model Unit {
  id        String     @id @default(uuid(7))
  name      String     @unique
  // FR-49, NFR-4: brings Unit in line with every other admin-configurable
  // lookup type's rename/disable lifecycle (MachineryType, VehicleType,
  // EmploymentType, ExpenseCategory) — disabling hides it from new-Material
  // entry forms without touching Materials already using it.
  isActive  Boolean    @default(true)
  materials Material[]
}

model Material {
  id           String            @id @default(uuid(7))
  categoryId   String
  category     MaterialCategory  @relation(fields: [categoryId], references: [id])
  unitId       String
  unit         Unit              @relation(fields: [unitId], references: [id])
  name         String
  isActive     Boolean           @default(true)
  customFields Json              @default("{}") // FR-7 — admin custom fields, no migration needed
  lowStockThreshold Decimal? // FR-36 — nullable: no threshold set means never flagged, never a default nobody chose

  sizes MaterialSize[]

  @@unique([categoryId, name])
}

model MaterialSize {
  id         String   @id @default(uuid(7))
  materialId String
  material   Material @relation(fields: [materialId], references: [id])
  label      String // e.g. "300mm"

  godownStock   GodownStock[]
  siteStock     SiteStock[]
  purchases     Purchase[]
  movements     Movement[]
  consumptions  Consumption[]
  returnWastages ReturnWastage[]

  @@unique([materialId, label])
}

// ---------- Inventory lifecycle (FR-8..FR-14) ----------
// GodownStock/SiteStock are materialized, write-path-only balances
// (AD-9): the only writer is the same transaction that inserts the
// causing Purchase/Movement/Consumption/ReturnWastage row.

model GodownStock {
  materialSizeId String
  materialSize   MaterialSize @relation(fields: [materialSizeId], references: [id])
  quantity       Decimal      @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([materialSizeId])
}

model SiteStock {
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id])
  materialSizeId String
  materialSize   MaterialSize @relation(fields: [materialSizeId], references: [id])
  quantity       Decimal      @default(0)
  updatedAt      DateTime     @updatedAt

  @@id([siteId, materialSizeId])
}

enum PurchaseDestination {
  GODOWN
  SITE
}

// Append-only (AD-9).
model Purchase {
  id                  String              @id @default(uuid(7))
  vendorId            String
  vendor              Vendor              @relation(fields: [vendorId], references: [id])
  materialSizeId       String
  materialSize         MaterialSize        @relation(fields: [materialSizeId], references: [id])
  destination          PurchaseDestination
  siteId               String? // required when destination = SITE (FR-8, FR-10)
  site                 Site?               @relation(fields: [siteId], references: [id])
  quantity             Decimal
  // Pricing is nullable (decision D7, 2026-09-01): a Site Supervisor records
  // the physical facts at the gate (vendor/material/quantity/challan) and the
  // Owner/Admin completes rate/totalAmount/paymentStatus later via
  // PATCH /purchases/:id/pricing. `totalAmount IS NULL` ⇔ "Pricing pending".
  // That PATCH is a one-time fill of these to-be-priced fields only — never
  // a change to an already-priced row (AD-9's append-only rule still governs
  // every recorded value; priced corrections go through the Correct flow).
  rate                 Decimal?
  totalAmount          Decimal?
  invoiceOrChallanNo   String?
  challanPhotoUrl      String?
  paymentStatus        String?
  deliveryLocation     String?
  vehicleDetails       String?
  receiverName         String? // FR-10 direct Vendor->Site
  notes                String?
  purchasedAt          DateTime
  createdAt            DateTime            @default(now())
  correctsId           String?
  reason               String?             // required when correctsId is set

  expenses Expense[]

  // list()/reportWhere() filters by siteId or vendorId and always orders
  // by purchasedAt desc; countPendingPricing() filters totalAmount+correctsId.
  @@index([siteId, purchasedAt])
  @@index([vendorId, purchasedAt])
  @@index([totalAmount, correctsId])
}

enum MovementKind {
  GODOWN_TO_SITE // FR-9
  SITE_TO_SITE   // FR-11
}

// Append-only (AD-9).
model Movement {
  id                 String       @id @default(uuid(7))
  kind               MovementKind
  materialSizeId      String
  materialSize        MaterialSize @relation(fields: [materialSizeId], references: [id])
  sourceSiteId         String? // null when kind = GODOWN_TO_SITE (source is the Godown)
  sourceSite           Site?        @relation("MovementSourceSite", fields: [sourceSiteId], references: [id])
  destinationSiteId    String
  destinationSite      Site         @relation("MovementDestinationSite", fields: [destinationSiteId], references: [id])
  sentQuantity          Decimal
  receivedQuantity       Decimal?    // shortage/damage gap = sentQuantity - receivedQuantity
  vehicleDetails         String?
  personResponsible      String?
  notes                  String?
  movedAt                DateTime
  createdAt              DateTime    @default(now())
  correctsId             String?
  reason                 String?

  // reportWhere() filters via OR(sourceSiteId, destinationSiteId) and always
  // orders by movedAt desc — a compound per leg lets Postgres satisfy each
  // side of the OR from an index instead of a sequential scan.
  @@index([materialSizeId])
  @@index([sourceSiteId, movedAt])
  @@index([destinationSiteId, movedAt])
}

// Append-only (AD-9).
model Consumption {
  id             String       @id @default(uuid(7))
  siteId         String
  site           Site         @relation(fields: [siteId], references: [id])
  materialSizeId  String
  materialSize    MaterialSize @relation(fields: [materialSizeId], references: [id])
  quantity         Decimal
  activityReference String?
  dailySiteReportId String?
  dailySiteReport   DailySiteReport? @relation(fields: [dailySiteReportId], references: [id])
  recordedByUserId   String
  notes              String?
  consumedAt          DateTime
  createdAt            DateTime @default(now())
  correctsId           String?
  reason               String?
  // Story 3.2: set by the offline queue at queue-write time so a retried
  // sync upserts the same row instead of creating a duplicate — this
  // model has no other natural key (a Site can legitimately have two
  // separate Consumption entries for the same Material on the same day).
  clientGeneratedId    String?  @unique

  // list()/reportWhere() filters by siteId, always orders by consumedAt
  // desc — the highest-write-volume table in the schema had no index at all.
  @@index([siteId, consumedAt])
}

enum ReturnWastageKind {
  RETURN
  WASTAGE
}

// Append-only (AD-9).
model ReturnWastage {
  id             String            @id @default(uuid(7))
  siteId         String
  site           Site              @relation(fields: [siteId], references: [id])
  materialSizeId  String
  materialSize    MaterialSize      @relation(fields: [materialSizeId], references: [id])
  kind            ReturnWastageKind
  quantity         Decimal
  notes             String?
  recordedAt         DateTime
  createdAt           DateTime @default(now())
  correctsId         String?
  reason             String?

  // reportWhere() filters by siteId, always orders by recordedAt desc.
  @@index([siteId, recordedAt])
}

// ---------- Machinery & Vehicles (FR-15..FR-18) ----------

enum AssetLocationStatus {
  AVAILABLE
  AT_SITE
  MAINTENANCE
}

// FR-15, NFR-4: admin-configurable data, not a hardcoded enum or free
// string — same minimal create+list-now, full admin lifecycle later
// (Epic 14) split Epic 4 Story 4.1 used for Unit (no isActive field
// either, same precedent).
model MachineryType {
  id        String      @id @default(uuid(7))
  name      String      @unique
  // Story 14.3 (FR-49, NFR-4): the full admin lifecycle Story 8.1 deferred to
  // Epic 14. Disabling hides the type from new-asset entry forms without
  // touching Machinery already assigned to it — master data, an in-place edit,
  // never one of AD-9's append-only tables.
  isActive  Boolean     @default(true)
  machinery Machinery[]
}

// FR-16, NFR-4: same split as MachineryType above — a separate table, not
// shared with it, since Machinery and Vehicle types aren't the same
// domain concept.
model VehicleType {
  id       String    @id @default(uuid(7))
  name     String    @unique
  // Story 14.3 (FR-49, NFR-4): same admin-lifecycle addition as MachineryType.
  isActive Boolean   @default(true)
  vehicles Vehicle[]
}

model Machinery {
  id             String              @id @default(uuid(7))
  name           String
  typeId         String
  type           MachineryType       @relation(fields: [typeId], references: [id])
  assetNumber    String              @unique
  model          String?
  ownership      String?
  operator       String?
  currentStatus  AssetLocationStatus @default(AVAILABLE)
  currentSiteId  String?
  currentSite    Site?               @relation(fields: [currentSiteId], references: [id])
  customFields   Json                @default("{}")

  movementLogs   MachineryMovementLog[]
  serviceLogs    MachineryServiceLog[]
  wasteDisposals WasteDisposal[]
}

// Append-only (AD-9) — full movement history, not just current state.
// Story 8.2: a correction is a new row with correctsId set, whose
// toStatus/siteId is a full restatement of the corrected value (not a
// delta, unlike Purchase/Movement/Consumption's numeric quantities) — same
// plain correctsId/reason pattern as elsewhere in this schema, no
// enforced self-relation.
model MachineryMovementLog {
  id           String              @id @default(uuid(7))
  machineryId  String
  machinery    Machinery           @relation(fields: [machineryId], references: [id])
  toStatus     AssetLocationStatus
  siteId       String?
  site         Site?               @relation(fields: [siteId], references: [id])
  movedAt      DateTime
  createdAt    DateTime            @default(now())
  correctsId   String?
  reason       String?             // required when correctsId is set
}

model MachineryServiceLog {
  id          String    @id @default(uuid(7))
  machineryId String
  machinery   Machinery @relation(fields: [machineryId], references: [id])
  kind        String // fuel | maintenance | repair
  notes       String?
  cost        Decimal?
  serviceDate DateTime
  createdAt   DateTime  @default(now())
}

model Vehicle {
  id             String              @id @default(uuid(7))
  number         String              @unique
  typeId         String
  type           VehicleType         @relation(fields: [typeId], references: [id])
  ownership      String?
  driver         String?
  currentStatus  AssetLocationStatus @default(AVAILABLE)
  currentSiteId  String?
  currentSite    Site?               @relation(fields: [currentSiteId], references: [id])
  customFields   Json                @default("{}")

  movementLogs   VehicleMovementLog[]
  serviceLogs    VehicleServiceLog[]
  wasteDisposals WasteDisposal[]
}

// Append-only (AD-9). Same correction shape as MachineryMovementLog above.
model VehicleMovementLog {
  id         String              @id @default(uuid(7))
  vehicleId  String
  vehicle    Vehicle             @relation(fields: [vehicleId], references: [id])
  toStatus   AssetLocationStatus
  siteId     String?
  site       Site?               @relation(fields: [siteId], references: [id])
  movedAt    DateTime
  createdAt  DateTime            @default(now())
  correctsId String?
  reason     String?             // required when correctsId is set
}

model VehicleServiceLog {
  id          String   @id @default(uuid(7))
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  kind        String
  notes       String?
  cost        Decimal?
  serviceDate DateTime
  createdAt   DateTime @default(now())
}

// ---------- Labour (FR-19..FR-25) ----------

// FR-19, NFR-4: admin-configurable data, not a hardcoded enum — same
// minimal create+list-now, full admin lifecycle later (Epic 14) split
// Epic 4 Story 4.1 used for Unit.
model EmploymentType {
  id       String @id @default(uuid(7))
  name     String @unique
  isActive Boolean @default(true)

  teamMembers TeamMember[]
}

model TeamMember {
  id               String         @id @default(uuid(7))
  name             String
  designation      String?
  contact          String?
  employmentTypeId String
  employmentType   EmploymentType @relation(fields: [employmentTypeId], references: [id])
  isActive         Boolean        @default(true)

  // AD-9's materialized, write-path-only balance (Story 7.1) — same class
  // of column as GodownStock/SiteStock.quantity, never a value summed from
  // Advance/AdvanceAdjustment rows on every read.
  outstandingAdvanceBalance Decimal @default(0)

  workRecords WorkRecord[]
  advances    Advance[]
  payments    Payment[]
}

// One row per Team Member per Site per date (FR-20) — enforced at the
// application level (apps/api/src/dsr/dsr.service.ts), not by a DB unique
// constraint. Story 3.5: a correction that changes an existing crew
// member's attendance for an already-reported date needs to insert its own
// fresh WorkRecord row (AD-9 — the original's rows are never touched), which
// a hard unique constraint on (teamMemberId, workDate) would make
// impossible (a correction and the row it corrects can legitimately share
// the same team member + date). The "never two Sites, same date"
// double-booking rule this constraint used to enforce as a DB backstop
// moved to an explicit application-level check instead (same as
// DailySiteReport's own siteId+reportDate constraint, relaxed for the same
// reason).
model WorkRecord {
  id             String    @id @default(uuid(7))
  teamMemberId    String
  teamMember      TeamMember @relation(fields: [teamMemberId], references: [id])
  siteId           String
  site             Site       @relation(fields: [siteId], references: [id])
  workDate          DateTime  @db.Date
  attended            Boolean   @default(true)
  hours                Decimal?
  overtimeHours         Decimal?
  dailySiteReportId      String?
  dailySiteReport        DailySiteReport? @relation(fields: [dailySiteReportId], references: [id])
  createdAt              DateTime @default(now())

  @@index([teamMemberId, workDate])
  // list()/getDefaultCrew() also filter by siteId and order by workDate
  // desc, a shape the compound above (keyed on teamMemberId first) can't serve.
  @@index([siteId, workDate])
}

// Append-only (AD-9). `reason` is the business reason the Advance was
// given (e.g. "medical emergency") — a different question from why a
// correcting entry exists, so the correction pair below is a distinct,
// separately-named field (Story 7.1), same disambiguation DailySiteReport
// needed for its own pre-existing `notes` field.
model Advance {
  id                String   @id @default(uuid(7))
  teamMemberId      String
  teamMember        TeamMember @relation(fields: [teamMemberId], references: [id])
  amount            Decimal
  reason            String?
  paymentMethod     String?
  givenAt           DateTime
  createdAt         DateTime @default(now())
  correctsId        String?
  correctionReason  String? // required when correctsId is set

  adjustments AdvanceAdjustment[]

  // list() filters by teamMemberId, always orders by givenAt desc.
  @@index([teamMemberId, givenAt])
}

// Append-only (AD-9). FR-23: amount must never exceed the Advance's
// current outstanding balance — enforced in the service layer at the same
// transaction boundary that writes this row, not just at the UI. `note` is
// the free-form business note for the adjustment itself — same
// disambiguation as Advance.reason vs. correctionReason above.
model AdvanceAdjustment {
  id                String   @id @default(uuid(7))
  advanceId         String
  advance           Advance  @relation(fields: [advanceId], references: [id])
  paymentId         String?
  payment           Payment? @relation(fields: [paymentId], references: [id])
  amount            Decimal
  note              String?
  adjustedAt        DateTime
  createdAt         DateTime @default(now())
  correctsId        String?
  correctionReason  String? // required when correctsId is set

  // list() always orders by adjustedAt desc.
  @@index([advanceId, adjustedAt])
}

// Append-only (AD-9). No pre-existing reason/note field to collide with,
// so this uses the plain correctsId/reason pair (Purchase/Movement/
// Consumption's convention), not the disambiguated correctionReason name
// Advance/AdvanceAdjustment need above.
model Payment {
  id                String   @id @default(uuid(7))
  teamMemberId      String
  teamMember        TeamMember @relation(fields: [teamMemberId], references: [id])
  basePay           Decimal
  additionalAmount  Decimal  @default(0)
  deductions        Decimal  @default(0)
  netPayable        Decimal
  // Free text, e.g. "1-15 Aug 2026" — not a structured date range; no FR
  // requires a calendar-computed period (Story 7.3).
  payPeriod         String?
  status            String // pending | paid
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  correctsId        String?
  reason            String? // required when correctsId is set

  advanceAdjustments AdvanceAdjustment[]

  // reportWhere() filters by teamMemberId + createdAt; countPending()
  // filters by status alone.
  @@index([teamMemberId, createdAt])
  @@index([status])
}

// ---------- RMC (FR-26..FR-27) ----------

model RmcEntry {
  id            String   @id @default(uuid(7))
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id])
  vendorId      String
  vendor        Vendor   @relation(fields: [vendorId], references: [id])
  quantityM3    Decimal
  grade         String
  ratePerM3     Decimal
  totalAmount   Decimal
  invoiceOrChallanNo String?
  challanPhotoUrl String?
  deliveredAt   DateTime
  createdAt     DateTime @default(now())
  correctsId    String?
  reason        String?             // required when correctsId is set

  dailySiteReportId String?
  dailySiteReport   DailySiteReport? @relation(fields: [dailySiteReportId], references: [id])
  // Story 3.2 offline-sync idempotency key — same reasoning as
  // Consumption.clientGeneratedId.
  clientGeneratedId String? @unique

  // list() filters by siteId or vendorId, always orders by deliveredAt desc.
  @@index([siteId, deliveredAt])
  @@index([vendorId, deliveredAt])
}

// ---------- Daily Site Report (FR-28..FR-31) ----------

model DailySiteReport {
  id                String   @id @default(uuid(7))
  siteId            String
  site              Site     @relation(fields: [siteId], references: [id])
  reportDate        DateTime @db.Date
  submittedByUserId String
  submittedBy       User     @relation(fields: [submittedByUserId], references: [id])
  workCompleted     String?
  workInProgress    String?
  plannedWork       String?
  issuesBlockers    String?
  safetyObservations String?
  notes             String?
  createdAt         DateTime @default(now())

  workRecords   WorkRecord[]
  consumptions  Consumption[]
  photos        Photo[]
  expenses      Expense[]
  rmcEntries    RmcEntry[]
  dailyReports  DailyReport[]

  // Informational tagging only — "JCB 3DX was in use today" is not a
  // location/status change (that's Epic 8's MachineryMovementLog /
  // VehicleMovementLog concern), so this is deliberately not a relation.
  // Denormalized (stores the name at entry time) so this DSR's feed entry
  // still reads correctly even if the asset is later renamed/deleted.
  equipmentUsed Json @default("[]")

  // Story 3.5 (AD-9, FR-54): a correction is a new row, never an edit —
  // same plain correctsId/reason pattern as Purchase/Movement/Consumption
  // elsewhere in this schema, no enforced self-relation.
  correctsId String?
  reason     String? // required when correctsId is set

  @@index([siteId, reportDate])
  // supersededDsrIds() (apps/api/src/common/superseded-dsrs.ts) scans this
  // column on nearly every read path across the system.
  @@index([correctsId])
}

model Photo {
  id                String          @id @default(uuid(7))
  dailySiteReportId String
  dailySiteReport   DailySiteReport @relation(fields: [dailySiteReportId], references: [id])
  storageKey        String // Cloudflare R2 object key
  uploadedByUserId  String
  uploadedBy        User            @relation(fields: [uploadedByUserId], references: [id])
  createdAt         DateTime        @default(now())
}

// ---------- Vendors & Expenses (FR-39..FR-41) ----------

model Vendor {
  id                String   @id @default(uuid(7))
  name              String
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  materialsSupplied String[] @default([])
  // Soft delete — same rule as Site.deletedAt.
  deletedAt         DateTime?

  purchases      Purchase[]
  rmcEntries     RmcEntry[]
  wasteDisposals WasteDisposal[]
}

model ExpenseCategory {
  id       String    @id @default(uuid(7))
  name     String    @unique
  // Story 14.3 (FR-49, NFR-4): the full admin lifecycle Story 11.1 deferred to
  // Epic 14. Disabling hides the category from the Expense entry form without
  // touching Expenses already recorded against it.
  isActive Boolean   @default(true)
  expenses Expense[]
}

model Expense {
  id                String          @id @default(uuid(7))
  siteId            String
  site              Site            @relation(fields: [siteId], references: [id])
  categoryId        String
  category          ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount            Decimal
  description       String?
  paymentMethod     String?
  personOrVendor    String?
  purchaseId        String? // links an Expense that IS a Purchase's cost entry
  purchase          Purchase?       @relation(fields: [purchaseId], references: [id])
  dailySiteReportId String?
  dailySiteReport   DailySiteReport? @relation(fields: [dailySiteReportId], references: [id])
  incurredAt        DateTime
  createdAt         DateTime        @default(now())
  // Story 11.1 (AD-9, FR-41): a correction is a new, reason-carrying row
  // linked to the one it corrects — never an edit/delete. Plain
  // correctsId/reason pair (no pre-existing reason/note field on Expense to
  // collide with), same convention as Purchase/Movement/RmcEntry. A
  // correcting row's `amount` is a signed delta (Epic 5's Story 5.1 rule),
  // not a restated total.
  correctsId        String?
  reason            String? // required when correctsId is set
  // Story 3.2 offline-sync idempotency key — same reasoning as
  // Consumption.clientGeneratedId.
  clientGeneratedId String? @unique

  // list() filters by siteId and/or categoryId, always has an incurredAt
  // date bound.
  @@index([siteId, incurredAt])
  @@index([categoryId, incurredAt])
}

// Waste & Disposal (debris/excavated-material removal from a Site). A
// per-trip COST record: the contractor pays to move waste out — either a
// hired third party (vendorId + paymentStatus) or an own register asset
// (machineryId/vehicleId, no vendor). Append-only (AD-9): a correction is
// a new row with correctsId + reason whose tripCount/otherCharges are
// SIGNED deltas (Epic 5's Story 5.1 rule); ratePerTrip must match the
// original's, and totalAmount is always server-computed
// (tripCount × ratePerTrip + otherCharges — signed on corrections), never
// client-supplied.
model WasteDisposal {
  id               String     @id @default(uuid(7))
  siteId           String
  site             Site       @relation(fields: [siteId], references: [id])
  // Free text ("Debris", "Excavated earth / murum") — waste is not catalog
  // Material and gets no stock effect; a lookup table would be premature.
  wasteType        String
  // Informational only ("approx 40 MT") — cost is trips × rate, never this.
  quantityDetails  String?
  ownership        String // OWN | HIRED (Zod-enforced vocabulary)
  vendorId         String?
  vendor           Vendor?    @relation(fields: [vendorId], references: [id])
  machineryId      String?
  machinery        Machinery? @relation(fields: [machineryId], references: [id])
  vehicleId        String?
  vehicle          Vehicle?   @relation(fields: [vehicleId], references: [id])
  // Free text for hired dumpers/trucks that aren't in the own registers.
  vehicleDetails   String?
  tripCount        Int
  ratePerTrip      Decimal
  otherCharges     Decimal    @default(0) // loading/JCB/toll etc.
  totalAmount      Decimal // server-computed, see model comment
  disposalLocation String?
  // PAID | PARTIAL | UNPAID — HIRED rows only (same vocabulary as
  // Purchase.paymentStatus); null for OWN rows, never a fabricated PAID.
  paymentStatus    String?
  notes            String?
  disposedAt       DateTime
  recordedByUserId String
  createdAt        DateTime   @default(now())
  correctsId       String?
  reason           String? // required when correctsId is set

  // whereFor() filters by siteId and/or vendorId, always orders by
  // disposedAt desc.
  @@index([siteId, disposedAt])
}

// ---------- Branding & Automated Report Delivery (FR-32, FR-33) ----------

// Story 13.1: single-row app-configuration record for this deployment's own
// branding. This is NOT a `Tenant` table in AD-1's forbidden sense — no
// tenant_id, no cross-tenant selector; it is the same category of thing as
// infra/tenants/*.json's committed per-deployment config, just runtime-
// editable (a build-time/env-var config couldn't satisfy FR-47's "no publish
// step"). Seeded with exactly one row at deploy time (infra/prisma/seed.ts);
// Epic 14 later adds the admin UI that edits it. `primaryColor` defaults to
// this product's own accent-teal-700 token as a neutral placeholder.
//
// Story 14.1 (FR-47) extends 13.1's minimum three fields with the rest of the
// mockup's Branding section: two more brand-colour swatches (Secondary/Accent,
// defaulting to the accent-navy-800 / gold-500 token values), plus the
// registered address, contact phone and GSTIN. These do NOT recreate the model
// — 13.1's row is edited in place — so every generated report carries the full
// business identity, not just a name + one colour.
model BrandingConfig {
  id                String   @id @default(uuid(7))
  tenantName        String
  logoUrl           String?
  primaryColor      String   @default("#0F5257")
  secondaryColor    String   @default("#16273E")
  accentColor       String   @default("#C7912B")
  registeredAddress String?
  contactPhone      String?
  gstin             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Story 13.1 (FR-32): the compiled, auto-generated per-Site daily report.
// `content` is the fully-rendered payload — site name, date, a branding
// snapshot, and the work/labour/material/RMC/expense summary plus the DSR's
// free-text `equipmentUsed` tags (informational tags entered on the DSR, not
// machinery-at-site location data) drawn from the linked DSR's own relations —
// deliberately DENORMALIZED and stored
// at generation time: if BrandingConfig or the underlying DSR data changes
// afterwards, a historical report must still read exactly as it was
// delivered, never silently re-render with today's branding.
// `dailySiteReportId` is required — no DailyReport row exists for a Site/day
// with no DSR at all (AC #4), so this is not a nullable "maybe compiled"
// field.
model DailyReport {
  id                String          @id @default(uuid(7))
  siteId            String
  site              Site            @relation(fields: [siteId], references: [id])
  dailySiteReportId String
  dailySiteReport   DailySiteReport @relation(fields: [dailySiteReportId], references: [id])
  reportDate        DateTime        @db.Date
  content           Json
  generatedAt       DateTime        @default(now())

  deliveries ReportDelivery[]

  @@unique([siteId, reportDate])
}

// Story 13.1 (FR-33): one row per (DailyReport, channel). `status`/
// `attempts`/`lastError`/`deliveredAt` are narrowly mutable via retry — this
// is lifecycle completion of an in-progress delivery event, NOT an AD-9
// correction (the same reasoning Epic 5 Story 5.2's `confirmReceipt` and
// Epic 7 Story 7.3's `markPaid` already established: completing an
// in-progress event is not a transaction-history correction), so there is
// deliberately no correctsId/reason pair here. `@@unique([dailyReportId,
// channel])` makes delivery idempotent at the DB level: a re-run of the
// compile Cron (or a `?date=` backfill of an already-processed day) can never
// create a second row for the same channel, so no double-send is possible even
// under a check-then-act race — the create's P2002 is caught and treated as
// "already exists / skip send".
model ReportDelivery {
  id            String      @id @default(uuid(7))
  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id])
  channel       String
  status        String      @default("PENDING")
  attempts      Int         @default(0)
  lastError     String?
  deliveredAt   DateTime?
  createdAt     DateTime    @default(now())

  @@unique([dailyReportId, channel])
}

// Story 14.4 (FR-50): which channels receive automated reports, and to whom.
// This replaces Story 13.1's hardcoded enabled-channels set + Owner/Admin
// recipient default with real, admin-editable configuration. Same
// configuration-record category as BrandingConfig (Story 13.1) — NOT an AD-9
// transaction-history table (no correctsId/reason), edited in place. Seeded
// (infra/prisma/seed.ts) with exactly the three rows Story 13.1's defaults
// implied, so switching ReportDeliveryService to read from this table does not
// change day-one delivery behaviour. `channel` is @unique — it is the natural
// key the PATCH /notification-settings/:channel route targets. `recipientUserIds`
// holds User.id values (resolved to emails at send time); IN_APP ignores it
// (in-app "delivery" has no per-user targeting).
model NotificationChannelSetting {
  id               String   @id @default(uuid(7))
  channel          String   @unique
  enabled          Boolean  @default(false)
  recipientUserIds String[] @default([])
}

// Story 14.5 (FR-51): scheduled, multi-cadence delivery of Epic 13's report set
// (Site/Inventory/Labour/Machinery-Vehicle/Financial) — configured and run
// entirely INDEPENDENTLY of the daily-DSR delivery (FR-50 / Story 13.1). A
// separate model + a separate Cron job (POST /cron/run-report-schedules), never
// a shared "reports" scheduler with a mode flag: independence is structural, not
// conventional. Configuration record, edited in place (no correctsId/reason) —
// same category as NotificationChannelSetting / BrandingConfig, NOT an AD-9
// transaction-history table. `reportType`: SITE | INVENTORY | LABOUR |
// MACHINERY_VEHICLE | FINANCIAL. `frequency`: DAILY | WEEKLY | MONTHLY. `siteId`
// optional — a schedule can be Site-scoped or cover all Sites (null), matching
// Epic 13's own filter shape (plain scalar, not an FK relation — it is a query
// param the report endpoints accept, not a structural link). `lastRunAt` drives
// due-detection: a schedule is due when frequency-worth of time has elapsed
// since it, or immediately if null.
model ReportSchedule {
  id               String    @id @default(uuid(7))
  reportType       String
  frequency        String
  recipientUserIds String[]  @default([])
  enabled          Boolean   @default(false)
  siteId           String?
  lastRunAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// ---------- Subcontractor Management (CAP-17, FR-55..FR-63, Epic 18) ----------
//
// "Subcontractor" is deliberately NOT called "Contractor" — that word is
// already reserved (see Contractor/Company in the glossary) for the tenant
// itself. A Subcontractor is an external party engaged for a defined scope
// of Site work, distinct from a Vendor (supplies Material/RMC/services, not
// labour/work) and from a Team Member (internal labour pool, no commercial
// contract).

// Master data — mirrors Vendor field-for-field (external party, soft
// delete, no createdAt/updatedAt, edited in place via normal PATCH, never
// AD-9 append-only).
model Subcontractor {
  id             String    @id @default(uuid(7))
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  workCategories String[]  @default([])
  deletedAt      DateTime?

  siteContracts SiteContract[]
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

// A Subcontractor's engagement on one Site for one scope of work. Master/
// agreement data (like Site) edited in place via normal PATCH — NOT an AD-9
// append-only table; its own history isn't ledgered, only the work/payments
// recorded against it are (SubcontractorWorkEntry, SubcontractorPayment
// below). `rateType` is a plain String, Zod-enforced vocabulary (same
// pattern as Purchase.paymentStatus) — FIXED_COST | PER_TRIP | PER_PIPE |
// PER_UNIT | CUSTOM — not a Prisma enum, since CUSTOM's free-text
// `rateUnitLabel` needs schema-level flexibility a hard enum doesn't help
// with. `rate`/`fixedAmount`/`rateUnitLabel`/`workCategory`/`startDate` may
// all be null while status is DRAFT (terms still being negotiated); the
// service layer requires them all present before allowing a transition to
// ACTIVE (see SiteContractsService) — deliberately NOT the D7 atomic
// one-time-fill mechanism from Purchase, since this table isn't append-only
// and a normal in-place edit already does the job with less machinery.
// `quantityCompleted`/`amountPaid` are materialized, write-path-only
// figures (AD-9 discipline) updated only in the same transaction as the
// causing WorkEntry/Payment row — never summed on read.
model SiteContract {
  id                String         @id @default(uuid(7))
  subcontractorId   String
  subcontractor     Subcontractor  @relation(fields: [subcontractorId], references: [id])
  siteId            String
  site              Site           @relation(fields: [siteId], references: [id])
  workCategory      String?
  description       String?
  rateType          String?
  rateUnitLabel     String?
  rate              Decimal?
  fixedAmount       Decimal?
  estimatedQuantity Decimal?
  status            ContractStatus @default(DRAFT)
  startDate         DateTime?
  endDate           DateTime?
  quantityCompleted Decimal        @default(0)
  amountPaid        Decimal        @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  workEntries SubcontractorWorkEntry[]
  payments    SubcontractorPayment[]

  // site-contracts.service.ts list() filters by siteId; subcontractorId
  // has no dedicated list query today but is a natural FK lookup.
  @@index([siteId])
  @@index([subcontractorId])
}

// Append-only (AD-9): a recorded quantity of work done against an Active,
// non-FIXED_COST Site Contract (trips run, pipes laid, units installed).
// Site Supervisor or Owner/Admin may write here — the one Supervisor-facing
// write surface in this whole feature area. Materializes
// SiteContract.quantityCompleted via a floor-checked increment (never below
// zero on a reducing correction).
model SubcontractorWorkEntry {
  id               String       @id @default(uuid(7))
  siteContractId   String
  siteContract     SiteContract @relation(fields: [siteContractId], references: [id])
  quantity         Decimal
  workDate         DateTime
  note             String?
  recordedByUserId String
  createdAt        DateTime     @default(now())
  correctsId       String?
  reason           String?

  // list() filters by siteContractId, always orders by workDate desc.
  @@index([siteContractId, workDate])
}

// Append-only (AD-9): a Payment or Advance made to a Subcontractor against
// a Site Contract. Owner/Admin only (money movement). `type` (ADVANCE |
// PAYMENT, Zod-enforced) is a display/reporting label only — both
// contribute identically to SiteContract.amountPaid; there is no separate
// Adjustment step netting one against the other (unlike TeamMember's
// Advance/AdvanceAdjustment/Payment triad — a Subcontractor advance has no
// recoverable-balance concept in this product's scope). No payable cap: an
// advance may legitimately exceed the amount currently payable.
model SubcontractorPayment {
  id               String       @id @default(uuid(7))
  siteContractId   String
  siteContract     SiteContract @relation(fields: [siteContractId], references: [id])
  type             String
  amount           Decimal
  paymentMethod    String?
  paidAt           DateTime
  note             String?
  recordedByUserId String
  createdAt        DateTime     @default(now())
  correctsId       String?
  reason           String?

  // list() filters by siteContractId, always orders by paidAt desc.
  @@index([siteContractId, paidAt])
}

{
  "name": "@azentisfieldos/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest build && node -r tsx/cjs dist/src/main.js",
    "start": "nest build && node -r tsx/cjs dist/src/main.js",
    "start:dev": "nest build && node -r tsx/cjs dist/src/main.js",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -r tsx/cjs dist/src/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@azentisfieldos/shared": "workspace:*",
    "@nestjs/jwt": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.7",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@azentisfieldos/config": "workspace:*",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "^1.10.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.1",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.5.2"
}
